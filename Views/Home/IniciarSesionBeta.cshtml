<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/IniciarSesionBeta.css">
    <link rel="stylesheet" href="~/css/headeryfooter.css">
    <title>Iniciar Sesión</title>
</head>
<body>
    <header>
        <a href="@Url.Action("Index", "Home")" class="navbar__logo">
            <img src="~/img/LOGO.png" alt="Match&Roll" />
        </a>
    </header>
    <main>
        <section>
                <h2>Iniciar Sesión</h2>
                <form method="post" action="@Url.Action("IniciarSesion", "Home")">
                    <div>
                        <label for="email">Correo electrónico:</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    <div>
                        <label for="contraseña">Contraseña:</label>
                        <input type="password" name="contraseña" required>
                    </div>
                    <button type="submit">Iniciar Sesión</button>
                </form>
                <p>¿No tienes una cuenta? <a href="@Url.Action("Registrarse", "Home")">Regístrate aquí</a></p>
        </section>
    </main>
    <footer>
        <ul>
            <li><a href="">Sobre nosotros</a></li>
            <li><a href="">Contacto</a></li>
            <li><a href="">Accesibilidad</a></li>
        </ul>

        <div>
            <img src="~/img/LOGO.png" alt="Match&Roll" class="site-footer__logo" />
            <div class="redesSociales">
                <a href="#" aria-label="X"><img src="~/img/x.png" alt="" /></a>
                <a href="#" aria-label="Facebook"><img src="~/img/facebook.png" alt="" /></a>
                <a href="#" aria-label="Instagram"><img src="~/img/instagram.png" alt="" /></a>
            </div>
            <small>Copyright &copy; @DateTime.Now.Year Match&amp;Roll</small>
        </div>

        <ul>
            <li><a href="">Que hacemos</a></li>
            <li><a href="">Aviso legal y privacidad</a></li>
            <li><a href="">Cookies</a></li>
        </ul>
    </footer>
    
</body>
</html>