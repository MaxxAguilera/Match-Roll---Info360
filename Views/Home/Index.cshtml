@{
    ViewData["Title"] = "MatchandRoll";
}

<div class="scroll-sections">
    <section class="page-section hero-section">
        <div class="section-frame">
            <div class="mini-toolbar">
                <span class="toolbar-dot"></span>
                <span class="toolbar-dot"></span>
                <span class="toolbar-dot"></span>
            </div>
            <div class="title-block">
                <h1>Formá tu banda<br />Matchéa</h1>
            </div>
        </div>
    </section>

    <section class="page-section form-section">
        <div class="section-frame compact-frame">
            <div class="field-stack">
                <label>NOMBRE</label>
                <div class="field-line"></div>
                <label>LOGO</label>
                <div class="field-line"></div>
            </div>
        </div>
    </section>

    <section class="page-section feature-section">
        <div class="section-frame feature-frame">
            <h2>Qué hacemos</h2>
            <div class="feature-row">
                <div class="feature-visual">
                    <div class="arrow left"></div>
                    <div class="arrow right"></div>
                </div>
                <div class="feature-copy">
                    <div class="dash-line"></div>
                    <div class="dash-line"></div>
                    <div class="dash-line"></div>
                    <div class="dash-line"></div>
                    <div class="dash-line"></div>
                    <div class="dash-line"></div>
                </div>
            </div>
        </div>
    </section>
</div>
