@using MatchRollInfo360.Models
@{
    ViewData["Match"] = "Match&Roll";

    Usuario? usuarioHeader = null;
    if (int.TryParse(Context.Session.GetString("id"), out int idUsuarioHeader) && idUsuarioHeader > 0)
    {
        usuarioHeader = new BD().MostrarUsuario(idUsuarioHeader);
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Match&Roll"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&family=Outfit:wght@400;500;600&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/matchroll.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar">
        <a href="@Url.Action("Index", "Home")" class="navbar__logo">
            <img src="~/img/LOGO.png" alt="Match&Roll" />
        </a>

        @if (!(ViewData["HideNav"] as bool? ?? false))
        {
            <nav class="navbar__nav">
                <a href="@Url.Action("VistaMatch", "Home")" class="navbar__btn">match</a>
                <a href="@Url.Action("VistaSalas", "Home")" class="navbar__btn">salas</a>
                <a href="@Url.Action("VistaChat", "Home")" class="navbar__msg" aria-label="Mensajes" id="navbarMensajes">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 7.5A2.5 2.5 0 0 1 7.5 5h9A2.5 2.5 0 0 1 19 7.5v6A2.5 2.5 0 0 1 16.5 16H11l-5 3v-3.5A2.5 2.5 0 0 1 5 13.5v-6Z"/>
                        <path d="M8.5 9.5h7M8.5 12.5h5"/>
                    </svg>
                    <span id="mensajesNoLeidosBadge" class="navbar__msg-badge" hidden>0</span>
                </a>
                <a href="@Url.Action("VistaPerfil", "Home")" class="navbar__avatar" aria-label="Mi perfil">
                    @if (usuarioHeader?.fotoPerfil != null && usuarioHeader.fotoPerfil.Length > 0)
                    {
                        <img src="@Url.Action("FotoPerfil", "Home", new { id = usuarioHeader.idUsuario })" alt="Foto de perfil" />
                    }
                    else
                    {
                        <svg viewBox="0 0 52 52" aria-hidden="true">
                            <circle cx="26" cy="19" r="8" />
                            <path d="M9 52c0-11 7.5-17 17-17s17 6 17 17z" />
                        </svg>
                    }
                </a>
            </nav>
        }
    </header>
    <main>
        <section class="hero">
            <div class="card hero-card">
                <img src="~/img/landing1foto.png" class="card-img" alt="primera foto landing">
                <div class="card-img-overlay hero-card__overlay">
                    <h4 class="card-title">Formá tu banda.<br />Matchéa</h4>
                    <a href='@Url.Action("VistaMatch", "Home")' class="hero-card__btn">Empezá ahora</a>
                </div>
            </div>
        </section>

        <section class="que-hacemos">
            <h2>Qué hacemos</h2>


            <div class="que-hacemos__content">
                <div class="que-hacemos__gallery">
                    <div id="carouselStackedBottom" class="carousel slide">
                        <div class="carousel-inner rounded-5">
                            <div class="carousel-item active">
                                <img src="~/img/fototano1.jpg" class="d-block w-100" alt="Banda tocando en vivo">
                            </div>
                            <div class="carousel-item">
                                <img src="~/img/fotosalva.jpg" class="d-block w-100" alt="Banda in un bar">
                            </div>
                            <div class="carousel-item">
                                <img src="~/img/fotojuan.jpg" class="d-block w-100" alt="Banda posando">
                            </div>
                        </div>
                    </div>
                    <p class="photo-caption">Fotos de resultados</p>
                    <div class="carousel-controls">
                        <button class="btn-icon btn-sm" type="button" data-bs-target="#carouselStackedBottom" data-bs-slide="prev">
                            <span class="carousel-icon-prev" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="btn-icon btn-sm" type="button" data-bs-target="#carouselStackedBottom" data-bs-slide="next">
                            <span class="carousel-icon-next" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>


                <p class="que-hacemos__text">
                    Conectamos músicos y artistas de todo tipo para que puedan formar bandas, colaborar en proyectos y compartir su música. Nuestra plataforma facilita el encuentro entre talentos, ofreciendo herramientas para crear perfiles, mostrar habilidades y encontrar compañeros de banda con intereses similares.
                </p>
            </div>
        </section>

        <section class="brand-photo">
            <img class="deco deco--headphones-right" src="~/img/deco/auriculares.svg" alt="" />
            <img class="deco deco--mic-left" src="~/img/deco/microfono.svg" alt="" />
            <img class="deco deco--bolt-mic" src="~/img/deco/rayo.svg" alt="" />


            <p class="brand-photo__wordmark">MATCH&amp;ROLL</p>
            <img class="brand-photo__logo" src="~/img/logo.png" alt="Match&Roll" />


            <figure class="photo-frame photo-frame--wide">
                <img src="~/img/patioort.jpg" alt="Banda en un bar" />
                <figcaption>Fotos de resultados</figcaption>
            </figure>
        </section>

        <section class="crear-cuenta">
            <img class="deco deco--squiggle-purple-left" src="~/img/violeta.png" alt="violeta" />
            <img class="deco deco--vinyl-left-2" src="~/img/disco.png" alt="" />
            <img class="deco deco--guitar-right-2" src="~/img/guitarra.png" alt="" />
            <img class="deco deco--bolt-right-3" src="~/img/deco/rayo.svg" alt="" />


            <h2>Creá tu cuenta</h2>


            <div class="crear-cuenta__content">
                <figure class="photo-frame photo-frame--portrait">
                    <img src="~/img/banda.jpg" alt="Banda posando" />
                    <figcaption>Fotos de resultados</figcaption>
                </figure>


                <div class="crear-cuenta__box">
                    <a href='@Url.Action("VistaIniciarSesion", "Home")' class="mr-btn mr-btn--xs">inicia sesion</a>
                    <a href='@Url.Action("Registrarse", "Home")' class="mr-btn mr-btn--xs">crea tu cuenta</a>
                </div>
            </div>
        </section>

        <section class="por-que">
            <h2>Por qué deberías usar Match&amp;Roll</h2>
            <div class="por-que__cols">
                <p>Somos la unica red social para artistas como vos.</p>
                <p>Ya hemos conseguido resultados muy buenos en el ambiente.</p>
                <p>Queremos ayudar porque tambien somos artistas y estivimos en su situación.</p>
            </div>
        </section>
    </main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@if (Context.Session.GetString("id") != null)
{
    <script>
        (() => {
            const idUsuario = @Context.Session.GetString("id");
            const badge = document.getElementById("mensajesNoLeidosBadge");

            async function actualizarMensajesNoLeidos() {
                try {
                    const response = await fetch('@Url.Action("ObtenerMensajesNoLeidos", "Home")');
                    if (!response.ok) return;

                    const data = await response.json();
                    const cantidad = Number(data.cantidad || 0);

                    if (badge) {
                        badge.textContent = cantidad > 99 ? "99+" : cantidad.toString();
                        badge.hidden = cantidad === 0;
                    }
                } catch (error) {
                    console.error("No se pudo actualizar la notificación de mensajes:", error);
                }
            }

            actualizarMensajesNoLeidos();
            setInterval(actualizarMensajesNoLeidos, 10000);
        })();
    </script>
}
</body>
</html>



