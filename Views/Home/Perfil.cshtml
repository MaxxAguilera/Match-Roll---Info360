
@{
    ViewData["Title"] = "Perfil";

}

<link rel="stylesheet" href="~/css/Perfil.css" asp-append-version="true" />
<div class="perfil-page">
    <main class="perfil-shell">
        <section class="perfil-main">
            <section class="perfil-form-section">
                <form class="perfil-form" method="post" action="@Url.Action("RegistrarDatosCompleto", "Home")">
                    <section class="perfil-visual">
                        <div class="perfil-avatar" aria-label="Foto de perfil"></div>

                        <div class="perfil-etiquetas-box">
                            <strong>Mis etiquetas</strong>

                            @foreach (var etiqueta in ViewBag.etiquetas)
                            {
                                <label class="perfil-etiqueta">
                                    <input type="checkbox"
                                        name="IdsEtiquetas"
                                        value="@etiqueta.idEtiqueta"
                                        @(ViewBag.idsEtiquetasUsuario.Contains(etiqueta.idEtiqueta) ? "checked" : "") />

                                    @etiqueta.nombreEtiqueta
                                </label>
                            }
                        </div>
                    </section>
                    <input type="hidden" name="idUsuario" value="@ViewBag.usuario.idUsuario" />
                    <section class="perfil-field-group">
                        <div class="perfil-field">
                            <label for="apodo">Nombre de usuario:</label>
                            <input id="apodo" name="apodo" type="text" value="@ViewBag.usuario.apodo" />
                        </div>

                        <div class="mb-3">
                            <label for="biografia" class="form-label">Descripción:</label>
                            <textarea id="biografia" name="biografia" class="form-control form-control-sm" rows="3" placeholder="Placeholder">@ViewBag.usuario.biografia</textarea>
                        </div>
                    </section>

                    <section class="perfil-field-group">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="nombre" class="form-label">Nombre</label>
                                <input id="nombre" name="nombre" type="text" class="form-control form-control-sm" value="@ViewBag.usuario.nombre" placeholder="Placeholder" />
                            </div>

                            <div class="col-md-6">
                                <label for="apellido" class="form-label">Apellido</label>
                                <input id="apellido" name="apellido" type="text" class="form-control form-control-sm" value="@ViewBag.usuario.apellido" placeholder="Placeholder" />
                            </div>
                        </div>

                        <div class="row g-3 mt-0">
                            <div class="col-md-6">
                                <label for="edad" class="form-label">Edad</label>
                                <input id="edad" name="edad" type="number" min="1" max="100" class="form-control form-control-sm" value="@ViewBag.usuario.edad" placeholder="Placeholder" />
                            </div>

                            <div class="col-md-6">
                                <label for="genero" class="form-label">Género</label>
                                <select id="genero" name="genero" class="form-select form-select-sm">
                                    <option value="">@ViewBag.usuario.genero</option>
                                    <option value="Masculino">Masculino</option>
                                    <option value="Femenino">Femenino</option>
                                    <option value="No binario">No binario</option>
                                    <option value="Prefiero no decirlo">Prefiero no decirlo</option>
                                </select>
                            </div>
                        </div>
                    </section>

                    <section class="perfil-field-group">
                        <div class="mb-3 mt-3">
                            <label for="email" class="form-label">Correo electrónico</label>
                            <input id="email" name="email" type="email" class="form-control form-control-sm" value="@ViewBag.usuario.email" placeholder="Placeholder" />
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="instrumentoPrincipal" class="form-label">Instrumento principal</label>
                                <input id="instrumentoPrincipal" name="instrumentoPrincipal" type="text" class="form-control form-control-sm" value="@ViewBag.usuario.instrumentoPrincipal" placeholder="Placeholder" />
                            </div>

                            <div class="col-md-6">
                                <label for="nivelExperiencia" class="form-label">Nivel de experiencia</label>
                                <select id="nivelExperiencia" name="nivelExperiencia" class="form-select form-select-sm">
                                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.usuario.nivelExperiencia) ? "selected" : null)">Placeholder</option>
                                    <option value="Principiante" selected="@(ViewBag.usuario.nivelExperiencia == "Principiante" ? "selected" : null)">Principiante</option>
                                    <option value="Intermedio" selected="@(ViewBag.usuario.nivelExperiencia == "Intermedio" ? "selected" : null)">Intermedio</option>
                                    <option value="Avanzado" selected="@(ViewBag.usuario.nivelExperiencia == "Avanzado" ? "selected" : null)">Avanzado</option>
                                    <option value="Profesional" selected="@(ViewBag.usuario.nivelExperiencia == "Profesional" ? "selected" : null)">Profesional</option>
                                </select>
                            </div>
                        </div>
                    </section>

                    <section class="perfil-field-group">
                        <div class="row g-3 mt-0">
                            <div class="col-md-6">
                                <label for="tipoUsuario" class="form-label">Tipo de usuario</label>
                                <select id="tipoUsuario" name="tipoUsuario" class="form-select form-select-sm">
                                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.usuario.tipoUsuario) ? "selected" : null)">Placeholder</option>
                                    <option value="Músico" selected="@(ViewBag.usuario.tipoUsuario == "Músico" ? "selected" : null)">Músico</option>
                                    <option value="Dueño de sala" selected="@(ViewBag.usuario.tipoUsuario == "Dueño de sala" ? "selected" : null)">Dueño de sala</option>
                                    <option value="Ambos" selected="@(ViewBag.usuario.tipoUsuario == "Ambos" ? "selected" : null)">Ambos</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label for="contraseña" class="form-label">Contraseña</label>
                                <input id="contraseña" name="contraseña" type="password" class="form-control form-control-sm" value="@ViewBag.usuario.contraseña" placeholder="Placeholder" />
                            </div>
                        </div>

                        <div class="form-field">
                            <label for="fieldSelect" class="form-label">Ubicación</label>
                            <select class="form-control" id="fieldSelect" name="idUbicacion">
                                <option value="0" selected="@(ViewBag.usuario.idUbicacion == 0 ? "selected" : null)">Elige tu ciudad</option>
                                <option value="1" selected="@(ViewBag.usuario.idUbicacion == 1 ? "selected" : null)">CABA</option>
                                <option value="2" selected="@(ViewBag.usuario.idUbicacion == 2 ? "selected" : null)">Buenos Aires</option>
                                <option value="3" selected="@(ViewBag.usuario.idUbicacion == 3 ? "selected" : null)">Santa Fe</option>
                                <option value="4" selected="@(ViewBag.usuario.idUbicacion == 4 ? "selected" : null)">Otro</option>
                            </select>
                        </div>
                    </section>

                    <section class="perfil-field-group">
                        <div class="mb-3 mt-3">
                            <label for="videoPrincipal" class="form-label">URL del video principal</label>
                            <input id="videoPrincipal" name="videoPrincipal" type="url" class="form-control form-control-sm" value="@ViewBag.usuario.videoPrincipal" placeholder="https://youtube.com/watch?v=..." />
                        </div>
                    </section>

                    <section class="perfil-actions mt-4">
                        <button type="button" class="btn btn-light btn-sm perfil-cancelar">Cancelar</button>
                        <button type="submit" class="btn btn-primary btn-sm perfil-guardar">Guardar</button>
                    </section>
                </form>
            </section>
        </section>
    </main>
</div>
