@{
    ViewData["Title"] = "Match&Roll";
    ViewData["HideNav"] = true;
    ViewData["BodyClass"] = "paginaInicio";
}
        <section class="portada">
            <div class="tarjetaPortada">
                <img src="~/img/landing1foto.png" alt="Músicos conectándose en Match&Roll" />
                <div class="contenidoPortada">
                    <h1>Formá tu banda.<br /><span>Matchéa</span></h1>
                    <a href='@Url.Action("Registrarse", "Home")' class="botonInicio">Empezá ahora</a>
                </div>
            </div>
        </section>

        <section class="comoFunciona">
            <div class="contenedorDosElementosCentrados">
                <div>
                    <h2>¿Cómo funciona?</h2>
                    <article>
                        <img src="~/img/iconoAgregarUsuario.png" alt="Icono de perfil" />
                        <div><strong>Creá tu perfil</strong><small>Contanos qué música te gusta y qué instrumento tocás.</small></div>
                    </article>
                    <article>
                        <img src="~/img/corazonMinimalista.png" alt="Corazón minimalista" />
                        <div><strong>Encontrá músicos</strong><small>Conocé otros músicos con los gustos y objetivos que buscás.</small></div>
                    </article>
                    <article>
                        <img src="~/img/iconoRosaDosPersonas.png" alt="Ícono de dos personas" />
                        <div><strong>¡Hagan match!</strong><small>Conectá, charlá y empezá a formar tu banda.</small></div>
                    </article>
                </div>

                <div class="fotoComoFunciona">
                    <img src="~/img/fototano1.JPG" alt="Banda tocando en vivo" />
                </div>
            </div>
        </section>

        <section class="porQueUsar">
            <h2>Por qué deberías usar Match&amp;Roll</h2>
            <div class="tarjetasPorQue">
                <article>
                    <strong>1.</strong>
                    <p>Somos <b>la única red social</b> para artistas como vos.</p>
                </article>
                <article>
                    <strong>2.</strong>
                    <p>Si sos músico, esta app está <b>hecha para vos.</b></p>
                </article>
                <article>
                    <strong>3.</strong>
                    <p>Queremos ayudar porque también somos artistas y estuvimos en tu situación.</p>
                </article>
            </div>
        </section>

        <section class="llamadaAccion">
            <h2>¿Qué estás esperando? Creá tu cuenta</h2>
            <div class="contenidoAccion">
                <img src="~/img/banda.JPG" alt="Integrantes de una banda" />
                <div class="textoAccion">
                    <p>Tu proyecto musical está a tan solo un <strong>click.</strong></p>
                    <a href='@Url.Action("Registrarse", "Home")' class="botonInicio">Registrarse</a>
                </div>
            </div>
         </section>
         <section>
            <img class="logoFinal" src="~/img/logo.png" alt="Match&Roll" />
            <img class="fotoFinal" src="~/img/patioort.JPG" alt="Banda tocando para una audiencia" />
        </section>