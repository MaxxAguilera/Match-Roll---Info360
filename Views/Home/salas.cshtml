@{
    Layout = null;
    ViewData["Title"] = "Salas";
}
<!DOCTYPE html>
<html lang="es">
<head>
     <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Match&Roll"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&family=Outfit:wght@400;500;600&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/matchroll.css" asp-append-version="true" />
</head>
<body>

    <header class="navbar">
        <a href='@Url.Action("Index", "Home")' class="navbar__logo">
           <img src="~/Img/logo.png" alt="Match&Roll" >
        </a>

        <nav class="navbar__nav">
            <a href='@Url.Action("VistaMatch", "Home")' class="navbar__btn">match</a>
            <a href='@Url.Action("VistaSalas", "Home")' class="navbar__btn">salas</a>
            <a href='@Url.Action("VistaPerfil", "Home")' class="navbar__avatar" aria-label="Mi perfil">
                <svg viewBox="0 0 52 52" aria-hidden="true">
                    <circle cx="26" cy="19" r="8" />
                    <path d="M9 52c0-11 7.5-17 17-17s17 6 17 17z" />
                </svg>
            </a>
        </nav>
    </header>

    <main style="padding:28px;">
        <div class="page-frame" style="background:#d7cfcf;padding:18px;">

            <!-- Barra de búsqueda principal -->
            <div class="search-bar" style="background:#e9e6e6;padding:18px;margin-bottom:18px;border-radius:6px;display:flex;justify-content:center;">
                <label for="global-search" class="visually-hidden">Buscar salas</label>
                <input id="global-search" type="search" placeholder="Buscar" style="width:60%;padding:10px 14px;border-radius:8px;border:1px solid #bbb;" />
            </div>

            <div class="layout" style="display:grid;grid-template-columns:1fr 320px;gap:22px;align-items:start;">

                <!-- Galería central -->
                <section class="gallery" aria-label="Listado de salas" style="background:#9a9a9a;padding:18px;height:520px;overflow:auto;box-shadow:inset 0 0 0 8px rgba(0,0,0,0.05);">
                    <div class="row row-cols-1 row-cols-md-3 g-4">
                        @for (int r = 0; r < 9; r++) {
                        <div class="col">
                            <div class="card h-100">
                                <img src="~/Img/ElCaminoSalaDeEnsayo.png" class="card-img-top" alt="Foto sala" style="object-fit:cover;height:160px;" />
                                <div class="card-body">
                                    <h4 class="card-title">El Camino - Balvanera</h4>
                                    <p class="card-text">Sala equipada con 4 amplificadores y batería. Ideal para ensayos y grabaciones.</p>
                                </div>
                            </div>
                        </div>
                        }
                    </div>
                </section>

                <!-- Panel de filtros -->
                <aside class="filters" aria-label="Filtros" style="background:#d8cfcf;padding:18px;border-radius:6px;">
                    <h3 style="margin-top:0;margin-bottom:14px;font-size:20px;">Filtros</h3>
                    <div style="margin-bottom:14px;">
                        <label for="filter-search" class="visually-hidden">Buscar filtro</label>
                        <input id="filter-search" type="search" placeholder="" style="width:100%;padding:8px;border-radius:8px;border:1px solid #bbb;" />
                    </div>

                    <div class="filter-list" style="display:flex;flex-direction:column;gap:12px;">
                        <button class="filter-item" style="display:flex;justify-content:space-between;align-items:center;padding:14px;background:#e9e6e6;border:1px solid #bdbdbd;border-radius:6px;">Barrio <span>›</span></button>
                        <button class="filter-item" style="display:flex;justify-content:space-between;align-items:center;padding:14px;background:#e9e6e6;border:1px solid #bdbdbd;border-radius:6px;">Precio <span>›</span></button>
                        <button class="filter-item" style="display:flex;justify-content:space-between;align-items:center;padding:14px;background:#e9e6e6;border:1px solid #bdbdbd;border-radius:6px;">Instrumentos <span>›</span></button>
                        <button class="filter-item" style="display:flex;justify-content:space-between;align-items:center;padding:14px;background:#e9e6e6;border:1px solid #bdbdbd;border-radius:6px;">Capacidad <span>›</span></button>
                        <button class="filter-item" style="display:flex;justify-content:space-between;align-items:center;padding:14px;background:#e9e6e6;border:1px solid #bdbdbd;border-radius:6px;">Tamaño <span>›</span></button>
                        <button class="filter-item" style="display:flex;justify-content:space-between;align-items:center;padding:14px;background:#e9e6e6;border:1px solid #bdbdbd;border-radius:6px;">Estrellas <span>›</span></button>
                    </div>
                </aside>

            </div>

        </div>
    </main>
    <footer class="site-footer">
        <ul class="site-footer__links site-footer__links--left">
            <li><a href="/Sobre-nosotros">Sobre nosotros</a></li>
            <li><a href="/Contacto">Contacto</a></li>
            <li><a href="/Accesibilidad">Accesibilidad</a></li>
        </ul>


        <div class="site-footer__center">
            <img src="~/img/LOGO.png" alt="Match&Roll" class="site-footer__logo" />
            <div class="site-footer__social">
                <a href="#" aria-label="X"><img src="~/img/x.png" alt="" /></a>
                <a href="#" aria-label="Facebook"><img src="~/img/facebook.png" alt="" /></a>
                <a href="#" aria-label="Instagram"><img src="~/img/instagram.png" alt="" /></a>
            </div>
            <small>Copyright &copy; @DateTime.Now.Year Match&amp;Roll</small>
        </div>


        <ul class="site-footer__links site-footer__links--right">
            <li><a href="/Que-hacemos">Que hacemos</a></li>
            <li><a href="/Aviso-legal">Aviso legal y privacidad</a></li>
            <li><a href="/Cookies">Cookies</a></li>
        </ul>
    </footer>   

</body>
</html>