@{
    ViewData["Title"] = "Chat";
    var chats = ViewBag.chats as List<MatchRollInfo360.Models.Chat> ?? new List<MatchRollInfo360.Models.Chat>();
    var idUsuarioActual = ViewBag.idUsuarioActual is int id ? id : 0;
    var idChatSeleccionado = ViewBag.idChatSeleccionado is int idChat ? idChat : (int?)null;
    var idOtroUsuario = ViewBag.idOtroUsuario is int otro ? otro : (int?)null;
    var apodoSeleccionado = ViewBag.apodoSeleccionado as string ?? string.Empty;
}

@using System.Text.Json
<script>
    const datosChatsDesdeServidor = @Html.Raw(JsonSerializer.Serialize(chats));
    const idUsuarioActual = @idUsuarioActual;
    const idChatSeleccionado = @((idChatSeleccionado is null ? "null" : idChatSeleccionado.ToString()));
    const idOtroUsuario = @((idOtroUsuario is null ? "null" : idOtroUsuario.ToString()));
    const apodoSeleccionado = @Html.Raw(JsonSerializer.Serialize(apodoSeleccionado));
</script>

<div class="chat-page">
    <aside class="chat-sidebar">
        <div class="chat-search-box">
            <input id="chatSearchInput" type="text" placeholder="Buscar" />
            <button type="button" aria-label="Buscar">⌕</button>
        </div>

        <div id="chatList" class="chat-list"></div>
    </aside>

    <section class="chat-panel">
        <div class="chat-panel__header">
            <div class="chat-panel__user">
                <div class="chat-avatar chat-avatar--large"></div>
                <span id="chatTitle">Seleccioná un chat</span>
            </div>
        </div>

        <div id="chatMessages" class="chat-panel__body"></div>

        <div class="chat-panel__composer">
            <button type="button" class="chat-btn chat-btn--ghost" aria-label="Agregar">＋</button>
            <input id="messageInput" type="text" placeholder="Escribí un mensaje..." />
            <button id="sendMessageButton" type="button" class="chat-btn chat-btn--send" aria-label="Enviar">➤</button>
        </div>
    </section>
</div>

<script>
    const chatList = document.getElementById("chatList");
    const chatMessages = document.getElementById("chatMessages");
    const chatTitle = document.getElementById("chatTitle");
    const messageInput = document.getElementById("messageInput");
    const sendMessageButton = document.getElementById("sendMessageButton");
    const chatSearchInput = document.getElementById("chatSearchInput");

    const chats = datosChatsDesdeServidor.map(chat => ({
        id: chat.idChat,
        idOtroUsuario: chat.idOtroUsuario,
        name: chat.apodo || "Usuario",
        ultimoMensaje: chat.ultimoMensaje || "Sin mensajes",
        messages: []
    }));

    let chatActivo = idChatSeleccionado ?? (chats[0]?.id ?? 0);

    function obtenerChatActivo() {
        return chats.find(c => c.id === chatActivo) ?? chats[0] ?? null;
    }

    async function cargarMensajesDelChat(idChat) {
        if (!idChat) return;

        try {
            const response = await fetch(`@Url.Action("ObtenerMensajesChat", "Home")?idChat=${idChat}`);
            if (!response.ok) return;

            const mensajes = await response.json();
            const chat = chats.find(c => c.id === idChat);
            if (!chat) return;

            chat.messages = mensajes.map(m => ({
                remitente: Number(m.idUsuarioEmisor) === Number(idUsuarioActual) ? "yo" : "otro",
                texto: m.contenido,
                fechaEnvio: m.fechaEnvio
            }));

            if (chat.messages.length > 0) {
                chat.ultimoMensaje = chat.messages[chat.messages.length - 1].texto;
            }

            renderChatList(chats);
            renderMensajes();
        } catch (error) {
            console.error("Error al cargar mensajes:", error);
        }
    }

    function filtrarChats() {
        const texto = (chatSearchInput.value || "").trim().toLowerCase();
        const lista = texto
            ? chats.filter(chat => (chat.name || "").toLowerCase().includes(texto))
            : chats;

        renderChatList(lista);
    }

    function renderChatList(listaChats) {
        chatList.innerHTML = "";

        if (!listaChats.length) {
            const vacio = document.createElement("div");
            vacio.className = "chat-empty-state";
            vacio.textContent = "No hay chats";
            chatList.appendChild(vacio);
            return;
        }

        listaChats.forEach((chat) => {
            const item = document.createElement("button");
            item.type = "button";
            item.className = "chat-item" + (chat.id === chatActivo ? " active" : "");
            item.innerHTML = `
                <div class="chat-avatar"></div>
                <div class="chat-item__meta">
                    <strong>${chat.name}</strong>
                    <span>${chat.ultimoMensaje || "Sin mensajes"}</span>
                </div>
            `;

            item.addEventListener("click", () => {
                chatActivo = chat.id;
                renderChatList(chats);
                cargarMensajesDelChat(chat.id);
            });

            chatList.appendChild(item);
        });
    }

    function renderMensajes() {
        const chat = obtenerChatActivo();
        if (!chat) {
            chatMessages.innerHTML = "";
            chatTitle.textContent = "Seleccioná un chat";
            return;
        }

        chatTitle.textContent = chat.name;
        chatMessages.innerHTML = "";

        if (!chat.messages.length) {
            const empty = document.createElement("div");
            empty.className = "chat-empty-messages";
            empty.textContent = "Todavía no hay mensajes.";
            chatMessages.appendChild(empty);
            return;
        }

        chat.messages.forEach((mensaje) => {
            const bubble = document.createElement("div");
            bubble.className = "chat-bubble " + (mensaje.remitente === "yo" ? "chat-bubble--outgoing" : "chat-bubble--incoming");
            bubble.textContent = mensaje.texto;
            chatMessages.appendChild(bubble);
        });

        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    async function enviarMensaje() {
        const texto = (messageInput.value || "").trim();
        if (!texto) return;

        const chat = obtenerChatActivo();
        if (!chat) return;

        try {
            const response = await fetch('@Url.Action("GuardarMensajeChat", "Home")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    idChat: chat.id,
                    idUsuarioEmisor: idUsuarioActual,
                    contenido: texto
                })
            });

            if (!response.ok) {
                throw new Error('No se pudo guardar el mensaje');
            }

            chat.messages.push({ remitente: "yo", texto: texto });
            chat.ultimoMensaje = texto;
            messageInput.value = "";
            renderChatList(chats);
            renderMensajes();
            await cargarMensajesDelChat(chat.id);
        } catch (error) {
            console.error("Error al enviar mensaje:", error);
            alert("No se pudo enviar el mensaje.");
        }
    }

    if (apodoSeleccionado && apodoSeleccionado !== "") {
        const chatDesdeMatch = chats.find(c => c.id === idChatSeleccionado || Number(c.idOtroUsuario) === Number(idOtroUsuario));
        if (!chatDesdeMatch) {
            chats.unshift({
                id: idChatSeleccionado ?? Date.now(),
                idOtroUsuario: Number(idOtroUsuario) || 0,
                name: apodoSeleccionado,
                ultimoMensaje: "Nuevo match",
                messages: []
            });
        } else {
            chatDesdeMatch.name = apodoSeleccionado;
            chatDesdeMatch.ultimoMensaje = "Nuevo match";
        }
        chatActivo = chats[0]?.id ?? 0;
    }

    sendMessageButton.addEventListener("click", enviarMensaje);
    messageInput.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
            enviarMensaje();
        }
    });

    chatSearchInput.addEventListener("input", filtrarChats);

    if (chats.length === 0) {
        chatTitle.textContent = "Todavía no tenés chats";
    }

    renderChatList(chats);
    if (chatActivo) {
        cargarMensajesDelChat(chatActivo);
    }
</script>
