    function normalizarVideoUrl(url) {
        const value = (url || "").trim();
        if (!value) return "";

        const youtubeMatch = value.match(/(?:https?:\/\/)?(?:www\.)?(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/|youtube-nocookie\.com\/embed\/)([A-Za-z0-9_-]{11})/i);
        if (youtubeMatch) {
            const videoId = youtubeMatch[1];
            return `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&rel=0&modestbranding=1&showinfo=0&controls=0&playsinline=1&enablejsapi=1`;
        }

        return value;
    }

    function mostrarVideo() {
        const usuario = listaFiltrada[indiceUsuario];
        const videos = usuario?.videos || [];
        const media = [];

        const urlPrincipal = (usuario?.urlVideo || "").trim();
        if (urlPrincipal) {
            media.push(urlPrincipal);
        }

        videos.forEach(url => {
            const value = (url || "").trim();
            if (value && !media.includes(value)) {
                media.push(value);
            }
        });

        if (media.length === 0) {
            if (videoContainer) videoContainer.innerHTML = "";
            if (sinVideo) sinVideo.hidden = false;
            if (contadorVideos) contadorVideos.textContent = "0 videos";

            if (btnAnterior) btnAnterior.hidden = true;
            if (btnSiguiente) btnSiguiente.hidden = true;

            return;
        }

        indiceVideo = (indiceVideo + media.length) % media.length;
        const rawUrl = (media[indiceVideo] || "").trim();
        const url = normalizarVideoUrl(rawUrl);

        if (sinVideo) sinVideo.hidden = true;
        if (videoContainer) videoContainer.innerHTML = "";

        const isYoutube = url.includes("youtube.com/embed/") || url.includes("youtube-nocookie.com/embed/");

        if (isYoutube) {
            const iframe = document.createElement("iframe");
            iframe.src = url;
            iframe.title = "Video del perfil";
            iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen";
            iframe.allowFullscreen = true;
            iframe.referrerPolicy = "strict-origin-when-cross-origin";
            iframe.style.width = "100%";
            iframe.style.height = "100%";
            iframe.style.border = "0";
            iframe.style.borderRadius = "16px";
            if (videoContainer) videoContainer.appendChild(iframe);
        } else {
            const video = document.createElement("video");
            video.controls = true;
            video.autoplay = true;
            video.muted = true;
            video.playsInline = true;
            video.src = url;
            video.style.width = "100%";
            video.style.height = "100%";
            video.style.borderRadius = "16px";
            if (videoContainer) videoContainer.appendChild(video);
        }

        if (contadorVideos) contadorVideos.textContent = `${indiceVideo + 1} / ${media.length}`;

        if (btnAnterior) btnAnterior.hidden = media.length <= 1;
        if (btnSiguiente) btnSiguiente.hidden = media.length <= 1;
    }

