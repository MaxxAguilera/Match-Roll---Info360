@using MatchRollInfo360.Models
@using System.Text.Json

@{
@using MatchRollInfo360.Models
@using System.Text.Json


    ViewData["Title"] = "Match";

    var usuarios = (List<Usuario>)ViewBag.usuarios;
    var idActual = int.Parse((string)ViewBag.idUsuarioActual);

    var usuariosJson = JsonSerializer.Serialize(
        usuarios
            .Where(u => u.idUsuario != idActual)
            .Select(u => new
            {
                u.idUsuario,
                u.apodo,
                u.edad,
                u.biografia,
                u.instrumentoPrincipal,
                u.idUbicacion,
                u.genero,
                videoPrincipal = u.videoPrincipal,
                etiquetas = u.etiquetas?
                    .Select(e => e.nombreEtiqueta)
                    .ToList() ?? new List<string>()
                
            })
            
    );
}
<div class="match-page">

    <main class="match-layout">

        <section class="perfil-seccion">

            <div class="perfil-card">

                <div class="video-area">

                    <div class="video-frame">
                        <div id="videoContainer"></div>

                        <div id="sinVideo" hidden class="no-video">
                            Este usuario todavía no tiene videos.
                        </div>

                        <button id="videoAnterior"
                                type="button"
                                aria-label="Video anterior"
                                class="video-nav video-prev">
                            &#9664;
                        </button>

                        <button id="videoSiguiente"
                                type="button"
                                aria-label="Video siguiente"
                                class="video-nav video-next">
                            &#9654;
                        </button>

                    </div>

                    <div class="video-meta">
                        <div class="meta-top">
                            <h2 id="nombrePerfil"></h2>
                            <div id="etiquetasPerfil" class="etiquetas"></div>
                        </div>
                        <p id="biografiaPerfil" class="bio"></p>
                        <p id="instrumentoPerfil" class="inst"></p>
                        <p id="contadorVideos" class="contador-videos">0 videos</p>
                    </div>

                </div>

            </div>

            <div class="acciones">
                <div class="acciones-inner">
                    <button id="btnLike" type="button" aria-label="Me gusta" class="accion-like">
                        <img src="@Url.Content("~/Img/Icono de pulgar arriba multicolor.png")" alt="Me gusta" />
                    </button>
                    <button id="btnDislike" type="button" aria-label="Pasar perfil" class="accion-dislike">
                        <img src="@Url.Content("~/Img/Icono de pulgar abajo multicolor.png")" alt="Pasar perfil" />
                    </button>
                </div>
            </div>

            <p id="mensajeFinal" hidden>
                ¡Ya viste todos los perfiles disponibles!
            </p>
            <div id="listaLikes" class="lista-likes" hidden></div>

        </section>

        <section class="filtros-seccion">
            <aside class="filtros">

                <div class="filtros-box">
                    <h2>Filtros</h2>

                    <input id="buscarPerfil"
                           type="search"
                           placeholder="Buscar usuario..." />

                    <div class="filtros-list">
                        <div class="match-form-field">
                            <button class="form-control match-combobox-toggle" type="button"
                                    data-bs-toggle="combobox"
                                    data-bs-name="edad"
                                    data-bs-placeholder="Elegí una edad…">
                                <span class="match-combobox-value">Elegí una edad…</span>
                                <svg class="match-combobox-caret" width="10" height="16" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.46967 5.46967C0.762563 5.17678 1.23744 5.17678 1.53033 5.46967L5 8.93934L8.46967 5.46967C8.76256 5.17678 9.23744 5.17678 9.53033 5.46967C9.82322 5.76256 9.82322 6.23744 9.53033 6.53033L5.53033 10.5303C5.23744 10.8232 4.76256 10.8232 4.46967 10.5303L0.46967 6.53033C0.176777 6.23744 0.176777 5.76256 0.46967 5.46967Z" fill="currentcolor"/></svg>
                            </button>
                            <div class="match-menu">
                                <button class="match-menu-item" type="button" data-bs-value="18-25">18-25</button>
                                <button class="match-menu-item" type="button" data-bs-value="26-35">26-35</button>
                                <button class="match-menu-item" type="button" data-bs-value="36-45">36-45</button>
                                <button class="match-menu-item" type="button" data-bs-value="45+">45+</button>
                            </div>
                        </div>

                        <div class="match-form-field">
                            <button class="form-control match-combobox-toggle" type="button"
                                    data-bs-toggle="combobox"
                                    data-bs-name="instrumento"
                                    data-bs-placeholder="Elegí un instrumento…">
                                <span class="match-combobox-value">Elegí un instrumento…</span>
                                <svg class="match-combobox-caret" width="10" height="16" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.46967 5.46967C0.762563 5.17678 1.23744 5.17678 1.53033 5.46967L5 8.93934L8.46967 5.46967C8.76256 5.17678 9.23744 5.17678 9.53033 5.46967C9.82322 5.76256 9.82322 6.23744 9.53033 6.53033L5.53033 10.5303C5.23744 10.8232 4.76256 10.8232 4.46967 10.5303L0.46967 6.53033C0.176777 6.23744 0.176777 5.76256 0.46967 5.46967Z" fill="currentcolor"/></svg>
                            </button>
                            <div class="match-menu">
                                <button class="match-menu-item" type="button" data-bs-value="Guitarra">Guitarra</button>
                                <button class="match-menu-item" type="button" data-bs-value="Batería">Batería</button>
                                <button class="match-menu-item" type="button" data-bs-value="Bajo">Bajo</button>
                                <button class="match-menu-item" type="button" data-bs-value="Voz">Voz</button>
                            </div>
                        </div>

                        <div class="match-form-field">
                            <button class="form-control match-combobox-toggle" type="button"
                                    data-bs-toggle="combobox"
                                    data-bs-name="ubicacion"
                                    data-bs-placeholder="Elegí una ubicación…">
                                <span class="match-combobox-value">Elegí una ubicación…</span>
                                <svg class="match-combobox-caret" width="10" height="16" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.46967 5.46967C0.762563 5.17678 1.23744 5.17678 1.53033 5.46967L5 8.93934L8.46967 5.46967C8.76256 5.17678 9.23744 5.17678 9.53033 5.46967C9.82322 5.76256 9.82322 6.23744 9.53033 6.53033L5.53033 10.5303C5.23744 10.8232 4.76256 10.8232 4.46967 10.5303L0.46967 6.53033C0.176777 6.23744 0.176777 5.76256 0.46967 5.46967Z" fill="currentcolor"/></svg>
                            </button>
                            <div class="match-menu">
                                <button class="match-menu-item" type="button" data-bs-value="1">CABA</button>
                                <button class="match-menu-item" type="button" data-bs-value="2">GBA</button>
                                <button class="match-menu-item" type="button" data-bs-value="3">Rosario</button>
                                <button class="match-menu-item" type="button" data-bs-value="4">Mendoza</button>
                            </div>
                        </div>

                        <div class="match-form-field">
                            <button class="form-control match-combobox-toggle" type="button"
                                    data-bs-toggle="combobox"
                                    data-bs-name="genero"
                                    data-bs-placeholder="Elegí un género…">
                                <span class="match-combobox-value">Elegí un género…</span>
                                <svg class="match-combobox-caret" width="10" height="16" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.46967 5.46967C0.762563 5.17678 1.23744 5.17678 1.53033 5.46967L5 8.93934L8.46967 5.46967C8.76256 5.17678 9.23744 5.17678 9.53033 5.46967C9.82322 5.76256 9.82322 6.23744 9.53033 6.53033L5.53033 10.5303C5.23744 10.8232 4.76256 10.8232 4.46967 10.5303L0.46967 6.53033C0.176777 6.23744 0.176777 5.76256 0.46967 5.46967Z" fill="currentcolor"/></svg>
                            </button>
                            <div class="match-menu">
                                <button class="match-menu-item" type="button" data-bs-value="Masculino">Masculino</button>
                                <button class="match-menu-item" type="button" data-bs-value="Femenino">Femenino</button>
                                <button class="match-menu-item" type="button" data-bs-value="No binario">No binario</button>
                                <button class="match-menu-item" type="button" data-bs-value="Prefiero no decirlo">Prefiero no decirlo</button>
                            </div>
                        </div>
                    </div>
                </div>

            </aside>
        </section>

    </main>

</div>

<script id="datosUsuarios" type="application/json">
    @Html.Raw(usuariosJson)
</script>

<script>
    const usuarios = JSON.parse(
        document.getElementById("datosUsuarios").textContent
    );

    const videoContainer = document.getElementById("videoContainer");
    const toggles = document.querySelectorAll('.match-combobox-toggle');
    const filtros = {
        edad: null,
        instrumento: null,
        ubicacion: null,
        genero: null
    };

    const normalizarTexto = (valor) =>
        (valor ?? "")
            .toString()
            .trim()
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/[^a-z0-9]/g, "");

    const coincideRangoEdad = (edad, rango) => {
        if (!rango) return true;
        const numero = Number(edad) || 0;

        if (rango === "18-25") return numero >= 18 && numero <= 25;
        if (rango === "26-35") return numero >= 26 && numero <= 35;
        if (rango === "36-45") return numero >= 36 && numero <= 45;
        if (rango === "45+") return numero >= 45;

        return true;
    };

    const coincideInstrumento = (usuarioInstrumento, filtro) => {
        if (!filtro) return true;
        const valorUsuario = normalizarTexto(usuarioInstrumento);
        const valorFiltro = normalizarTexto(filtro);

        if (!valorUsuario || !valorFiltro) return false;
        return valorUsuario.includes(valorFiltro) || valorFiltro.includes(valorUsuario);
    };

    const usuarioCumpleFiltros = (usuario, busqueda = "") => {
        const coincideBusqueda = !busqueda || (usuario.apodo || "").toLowerCase().includes(busqueda);
        const coincideEdad = coincideRangoEdad(usuario.edad, filtros.edad);
        const coincideInstrumentoPerfil = coincideInstrumento(usuario.instrumentoPrincipal, filtros.instrumento);
        const coincideUbicacion = !filtros.ubicacion || Number(usuario.idUbicacion) === Number(filtros.ubicacion);
        const coincideGenero = !filtros.genero || normalizarTexto(usuario.genero) === normalizarTexto(filtros.genero);

        return coincideBusqueda && coincideEdad && coincideInstrumentoPerfil && coincideUbicacion && coincideGenero;
    };

    let listaFiltrada = [...usuarios];
    let likedUsers = [];

    function renderLikedUsers() {
        if (!listaLikes) return;

        const usuariosLike = likedUsers;

        listaLikes.innerHTML = "";

        if (!usuariosLike.length) {
            listaLikes.hidden = true;
            if (mensajeFinal) {
                mensajeFinal.textContent = "No hay perfiles con esos filtros.";
                mensajeFinal.hidden = false;
            }
            return;
        }

        if (mensajeFinal) mensajeFinal.hidden = true;
        listaLikes.hidden = false;

        usuariosLike.forEach(usuario => {
            const item = document.createElement("div");
            item.className = "liked-user-item";

            const nombre = (usuario.apodo || "Usuario").trim() || "Usuario";
            const inicial = nombre.charAt(0).toUpperCase();

            item.innerHTML = `
                <div class="liked-user-main">
                    <div class="liked-user-avatar">${inicial}</div>
                    <span class="liked-user-name">${nombre}</span>
                </div>
                <button type="button" class="liked-user-message" aria-label="Mensaje pendiente" title="Mensaje pendiente">💬</button>
            `;

            const boton = item.querySelector(".liked-user-message");
            if (boton) {
                boton.addEventListener("click", () => {
                    window.location.href = '@Url.Action("VistaChat", "Home")';
                });
            }

            listaLikes.appendChild(item);
        });
    }

    function mostrarListaFinalSiNoHayMasPerfiles() {
        if (perfilSeccion) perfilSeccion.hidden = true;
        if (mensajeFinal) mensajeFinal.hidden = true;
        if (likedUsers.length > 0) {
            renderLikedUsers();
            return;
        }

        if (listaLikes) listaLikes.hidden = true;
        if (mensajeFinal) {
            mensajeFinal.textContent = "¡Ya viste todos los perfiles disponibles!";
            mensajeFinal.hidden = false;
        }
    }

    function aplicarFiltros() {
        const busqueda = (buscador?.value || "").trim().toLowerCase();

        listaFiltrada = usuarios.filter(usuario => usuarioCumpleFiltros(usuario, busqueda));
        indiceUsuario = 0;

        if (listaFiltrada.length === 0) {
            mostrarListaFinalSiNoHayMasPerfiles();
            return;
        }

        if (perfilSeccion) perfilSeccion.hidden = false;
        if (mensajeFinal) mensajeFinal.hidden = true;
        if (listaLikes) listaLikes.hidden = true;
        mostrarUsuario();
    }

    toggles.forEach(button => {
        const menu = button.nextElementSibling;
        const value = button.querySelector('.match-combobox-value');

        button.addEventListener('click', () => {
            const isOpen = menu.classList.contains('open');
            document.querySelectorAll('.match-menu').forEach(m => m.classList.remove('open'));
            if (!isOpen) {
                menu.classList.add('open');
            }
        });

        menu.querySelectorAll('.match-menu-item').forEach(item => {
            item.addEventListener('click', () => {
                const selectedValue = item.dataset.bsValue;
                const filterName = button.dataset.bsName;
                filtros[filterName] = selectedValue || null;
                value.textContent = item.textContent;
                menu.classList.remove('open');
                aplicarFiltros();
            });
        });
    });

    document.addEventListener('click', (event) => {
        if (!event.target.closest('.match-combobox-toggle') && !event.target.closest('.match-menu-item')) {
            document.querySelectorAll('.match-menu').forEach(m => m.classList.remove('open'));
        }
    });

    const video = document.getElementById("videoPerfil");
    const sinVideo = document.getElementById("sinVideo");
    const nombre = document.getElementById("nombrePerfil");
    const biografia = document.getElementById("biografiaPerfil");
    const instrumento = document.getElementById("instrumentoPerfil");
    const etiquetas = document.getElementById("etiquetasPerfil");
    const contadorVideos = document.getElementById("contadorVideos");

    const btnLike = document.getElementById("btnLike");
    const btnDislike = document.getElementById("btnDislike");
    const btnAnterior = document.getElementById("videoAnterior");
    const btnSiguiente = document.getElementById("videoSiguiente");

    const mensajeFinal = document.getElementById("mensajeFinal");
    const perfilSeccion = document.querySelector(".perfil-seccion");
    const buscador = document.getElementById("buscarPerfil");
    const listaLikes = document.getElementById("listaLikes");

    let indiceUsuario = 0;
    let indiceVideo = 0;

    function normalizarVideoUrl(url) {
        const value = (url || "").trim();
        if (!value) return "";

        const youtubeMatch = value.match(/(?:https?:\/\/)?(?:www\.)?(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/|youtube-nocookie\.com\/embed\/)([A-Za-z0-9_-]{11})/i);
        if (youtubeMatch) {
            const videoId = youtubeMatch[1];
            return `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&rel=0&modestbranding=1&showinfo=0&controls=0&playsinline=1&enablejsapi=1`;
        }

        return value;
    }

    function mostrarVideo() {
        const usuario = listaFiltrada[indiceUsuario];
        const videos = usuario?.videos || [];
        const media = [];

        const urlPrincipal = (usuario?.videoPrincipal || "").trim();
        if (urlPrincipal) {
            media.push(urlPrincipal);
        }

        videos.forEach(url => {
            const value = (url || "").trim();
            if (value && !media.includes(value)) {
                media.push(value);
            }
        });

        if (media.length === 0) {
            if (videoContainer) videoContainer.innerHTML = "";
            if (sinVideo) sinVideo.hidden = false;
            if (contadorVideos) contadorVideos.textContent = "0 videos";

            if (btnAnterior) btnAnterior.hidden = true;
            if (btnSiguiente) btnSiguiente.hidden = true;

            return;
        }

        indiceVideo = (indiceVideo + media.length) % media.length;
        const rawUrl = (media[indiceVideo] || "").trim();
        const url = normalizarVideoUrl(rawUrl);

        if (sinVideo) sinVideo.hidden = true;
        if (videoContainer) videoContainer.innerHTML = "";

        const isYoutube = url.includes("youtube.com/embed/") || url.includes("youtube-nocookie.com/embed/");

        if (isYoutube) {
            const iframe = document.createElement("iframe");
            iframe.src = url;
            iframe.title = "Video del perfil";
            iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen";
            iframe.allowFullscreen = true;
            iframe.referrerPolicy = "strict-origin-when-cross-origin";
            iframe.style.width = "100%";
            iframe.style.height = "100%";
            iframe.style.border = "0";
            iframe.style.borderRadius = "16px";
            if (videoContainer) videoContainer.appendChild(iframe);
        } else {
            const video = document.createElement("video");
            video.controls = true;
            video.autoplay = true;
            video.muted = true;
            video.playsInline = true;
            video.src = url;
            video.style.width = "100%";
            video.style.height = "100%";
            video.style.borderRadius = "16px";
            if (videoContainer) videoContainer.appendChild(video);
        }

        if (contadorVideos) contadorVideos.textContent = `${indiceVideo + 1} / ${media.length}`;

        if (btnAnterior) btnAnterior.hidden = media.length <= 1;
        if (btnSiguiente) btnSiguiente.hidden = media.length <= 1;
    }

    function mostrarUsuario() {
        if (indiceUsuario >= listaFiltrada.length) {
            mostrarListaFinalSiNoHayMasPerfiles();
            return;
        }

        const usuario = listaFiltrada[indiceUsuario];

        nombre.textContent = `${usuario.apodo || "Usuario"} (${usuario.edad ?? "Edad no indicada"})`;
        biografia.textContent = usuario.biografia || "Sin descripción";
        instrumento.textContent = "Instrumento: " + (usuario.instrumentoPrincipal || "No especificado");

        const etiquetasUsuario = usuario.etiquetas || [];

        etiquetas.replaceChildren();

        if (etiquetasUsuario.length > 0) {
            etiquetasUsuario.forEach((texto, index) => {
                const etiqueta = document.createElement("span");
                etiqueta.className = "etiqueta" + (index === 0 ? " primary" : "");
                etiqueta.textContent = texto;
                etiquetas.appendChild(etiqueta);
            });
        } else {
            const etiqueta = document.createElement("span");
            etiqueta.className = "etiqueta primary";
            etiqueta.textContent = "Sin etiqueta";
            etiquetas.appendChild(etiqueta);
        }

        indiceVideo = 0;
        mostrarVideo();
    }

    function siguienteUsuario() {
        indiceUsuario++;

        if (indiceUsuario >= listaFiltrada.length) {
            mostrarListaFinalSiNoHayMasPerfiles();
            return;
        }

        mostrarUsuario();
    }

    if (btnAnterior) btnAnterior.addEventListener("click", () => {
        indiceVideo--;
        mostrarVideo();
    });

    if (btnSiguiente) btnSiguiente.addEventListener("click", () => {
        indiceVideo++;
        mostrarVideo();
    });

    if (btnLike) {
        btnLike.addEventListener("click", async () => {
        const usuarioActual = listaFiltrada[indiceUsuario];

        if (!usuarioActual) return;

        btnLike.disabled = true;

        try {
            const respuesta = await fetch(
                '@Url.Action("DarLike", "Home")',
                {
                    method: "POST",
                    headers: {
                        "Content-Type":
                            "application/x-www-form-urlencoded"
                    },
                    body: new URLSearchParams({
                        idUsuarioReceptor:
                            usuarioActual.idUsuario
                    })
                }
                );

                if (!respuesta.ok) {
                    throw new Error("No se pudo registrar el like");
                }

                const resultado = await respuesta.json();

                if (resultado.hayMatch) {
                    alert(
                        "¡Hicieron match! " +
                        "Ahora podés chatear con este usuario."
                    );
                    window.location.href = '@Url.Action("VistaChat", "Home")';
                } else {
                    if (!likedUsers.some(u => u.idUsuario === usuarioActual.idUsuario)) {
                        likedUsers.push(usuarioActual);
                    }
                }

                siguienteUsuario();
            } catch (error) {
                alert("Ocurrió un error al registrar el like.");
            } finally {
                btnLike.disabled = false;
            }
        });
    }

    if (btnDislike) btnDislike.addEventListener("click", siguienteUsuario);
    if (buscador) buscador.addEventListener("input", aplicarFiltros);

    aplicarFiltros();
</script>