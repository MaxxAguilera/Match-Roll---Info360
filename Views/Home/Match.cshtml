@using MatchRollInfo360.Models
@using System.Text.Json

@{
    ViewData["Title"] = "Match";

    List<Usuario> usuarios = ViewBag.usuarios ?? new List<Usuario>();

    var opciones = usuarios.Select(u => new
    {
        idUsuario = u.idUsuario,
        apodo = u.apodo,
        edad = u.edad,
        biografia = u.biografia,
        instrumentoPrincipal = u.instrumentoPrincipal,

        etiquetas = u.etiquetas == null
            ? new List<string>()
            : u.etiquetas.Select(e => e.nombreEtiqueta).ToList(),

        videos = u.videos == null
            ? new List<string>()
            : u.videos.Select(v => v.urlVideo).ToList()
    });

    string usuariosJson = JsonSerializer.Serialize(opciones);
}

<div class="match-page">

    <main class="match-layout">

        <!-- PERFIL Y VIDEOS -->
        <section class="perfil-seccion">

            <div class="perfil-card">

                <div class="video-area">

                    <div class="video-frame">
                        <video id="videoPerfil"
                               controls
                               autoplay
                               muted
                               playsinline>
                        </video>

                        <div id="sinVideo" hidden class="no-video">
                            Este usuario todavía no tiene videos.
                        </div>

                        <button id="videoAnterior"
                                type="button"
                                aria-label="Video anterior"
                                class="video-nav video-prev">
                            &#9664;
                        </button>

                        <button id="videoSiguiente"
                                type="button"
                                aria-label="Video siguiente"
                                class="video-nav video-next">
                            &#9654;
                        </button>

                    </div>

                    <div class="video-meta">
                        <div class="meta-top">
                            <h2 id="nombrePerfil"></h2>
                            <div id="etiquetasPerfil" class="etiquetas"></div>
                        </div>
                        <p id="biografiaPerfil" class="bio"></p>
                        <p id="instrumentoPerfil" class="inst"></p>
                    </div>

                </div>

            </div>

            <!-- BOTONES DE LIKE Y DISLIKE -->
            <div class="acciones">
                <div class="acciones-inner">
                    <button id="btnLike" type="button" aria-label="Me gusta" class="accion-like">👍</button>
                    <button id="btnComentario" type="button" aria-label="Comentar" class="accion-coment">💬</button>
                    <button id="btnDislike" type="button" aria-label="Pasar perfil" class="accion-dislike">👎</button>
                </div>
            </div>

            <p id="mensajeFinal" hidden>
                ¡Ya viste todos los perfiles disponibles!
            </p>

        </section>

        <!-- FILTROS -->
        <aside class="filtros">

            <div class="filtros-box">
                <h2>Filtros</h2>

                <input id="buscarPerfil"
                       type="search"
                       placeholder="Buscar usuario..." />

                <div class="filtros-list">
                    <div class="match-form-field">
                        <button class="form-control match-combobox-toggle" type="button"
                                data-bs-toggle="combobox"
                                data-bs-name="edad"
                                data-bs-placeholder="Elegí una edad…">
                            <span class="match-combobox-value">Elegí una edad…</span>
                            <svg class="match-combobox-caret" width="10" height="16" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.46967 5.46967C0.762563 5.17678 1.23744 5.17678 1.53033 5.46967L5 8.93934L8.46967 5.46967C8.76256 5.17678 9.23744 5.17678 9.53033 5.46967C9.82322 5.76256 9.82322 6.23744 9.53033 6.53033L5.53033 10.5303C5.23744 10.8232 4.76256 10.8232 4.46967 10.5303L0.46967 6.53033C0.176777 6.23744 0.176777 5.76256 0.46967 5.46967Z" fill="currentcolor"/></svg>
                        </button>
                        <div class="match-menu">
                            <button class="match-menu-item" type="button" data-bs-value="18-25">18-25</button>
                            <button class="match-menu-item" type="button" data-bs-value="26-35">26-35</button>
                            <button class="match-menu-item" type="button" data-bs-value="36-45">36-45</button>
                            <button class="match-menu-item" type="button" data-bs-value="45+">45+</button>
                        </div>
                    </div>

                    <div class="match-form-field">
                        <button class="form-control match-combobox-toggle" type="button"
                                data-bs-toggle="combobox"
                                data-bs-name="instrumento"
                                data-bs-placeholder="Elegí un instrumento…">
                            <span class="match-combobox-value">Elegí un instrumento…</span>
                            <svg class="match-combobox-caret" width="10" height="16" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.46967 5.46967C0.762563 5.17678 1.23744 5.17678 1.53033 5.46967L5 8.93934L8.46967 5.46967C8.76256 5.17678 9.23744 5.17678 9.53033 5.46967C9.82322 5.76256 9.82322 6.23744 9.53033 6.53033L5.53033 10.5303C5.23744 10.8232 4.76256 10.8232 4.46967 10.5303L0.46967 6.53033C0.176777 6.23744 0.176777 5.76256 0.46967 5.46967Z" fill="currentcolor"/></svg>
                        </button>
                        <div class="match-menu">
                            <button class="match-menu-item" type="button" data-bs-value="guitarra">Guitarra</button>
                            <button class="match-menu-item" type="button" data-bs-value="bateria">Batería</button>
                            <button class="match-menu-item" type="button" data-bs-value="bajo">Bajo</button>
                            <button class="match-menu-item" type="button" data-bs-value="voz">Voz</button>
                        </div>
                    </div>

                    <div class="match-form-field">
                        <button class="form-control match-combobox-toggle" type="button"
                                data-bs-toggle="combobox"
                                data-bs-name="ubicacion"
                                data-bs-placeholder="Elegí una ubicación…">
                            <span class="match-combobox-value">Elegí una ubicación…</span>
                            <svg class="match-combobox-caret" width="10" height="16" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.46967 5.46967C0.762563 5.17678 1.23744 5.17678 1.53033 5.46967L5 8.93934L8.46967 5.46967C8.76256 5.17678 9.23744 5.17678 9.53033 5.46967C9.82322 5.76256 9.82322 6.23744 9.53033 6.53033L5.53033 10.5303C5.23744 10.8232 4.76256 10.8232 4.46967 10.5303L0.46967 6.53033C0.176777 6.23744 0.176777 5.76256 0.46967 5.46967Z" fill="currentcolor"/></svg>
                        </button>
                        <div class="match-menu">
                            <button class="match-menu-item" type="button" data-bs-value="caba">CABA</button>
                            <button class="match-menu-item" type="button" data-bs-value="gba">GBA</button>
                            <button class="match-menu-item" type="button" data-bs-value="rosario">Rosario</button>
                            <button class="match-menu-item" type="button" data-bs-value="mendoza">Mendoza</button>
                        </div>
                    </div>

                    <div class="match-form-field">
                        <button class="form-control match-combobox-toggle" type="button"
                                data-bs-toggle="combobox"
                                data-bs-name="genero"
                                data-bs-placeholder="Elegí un género…">
                            <span class="match-combobox-value">Elegí un género…</span>
                            <svg class="match-combobox-caret" width="10" height="16" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.46967 5.46967C0.762563 5.17678 1.23744 5.17678 1.53033 5.46967L5 8.93934L8.46967 5.46967C8.76256 5.17678 9.23744 5.17678 9.53033 5.46967C9.82322 5.76256 9.82322 6.23744 9.53033 6.53033L5.53033 10.5303C5.23744 10.8232 4.76256 10.8232 4.46967 10.5303L0.46967 6.53033C0.176777 6.23744 0.176777 5.76256 0.46967 5.46967Z" fill="currentcolor"/></svg>
                        </button>
                        <div class="match-menu">
                            <button class="match-menu-item" type="button" data-bs-value="rock">Rock</button>
                            <button class="match-menu-item" type="button" data-bs-value="pop">Pop</button>
                            <button class="match-menu-item" type="button" data-bs-value="jazz">Jazz</button>
                            <button class="match-menu-item" type="button" data-bs-value="metal">Metal</button>
                        </div>
                    </div>
                </div>
            </div>

        </aside>

    </main>

</div>

<script id="datosUsuarios" type="application/json">
    @Html.Raw(usuariosJson)
</script>

<script>
    const usuarios = JSON.parse(
        document.getElementById("datosUsuarios").textContent
    );

    const toggles = document.querySelectorAll('.match-combobox-toggle');

    toggles.forEach(button => {
        const menu = button.nextElementSibling;
        const value = button.querySelector('.match-combobox-value');

        button.addEventListener('click', () => {
            const isOpen = menu.classList.contains('open');
            document.querySelectorAll('.match-menu').forEach(m => m.classList.remove('open'));
            if (!isOpen) {
                menu.classList.add('open');
            }
        });

        menu.querySelectorAll('.match-menu-item').forEach(item => {
            item.addEventListener('click', () => {
                value.textContent = item.textContent;
                menu.classList.remove('open');
            });
        });
    });

    document.addEventListener('click', (event) => {
        if (!event.target.closest('.match-combobox-toggle') && !event.target.closest('.match-menu-item')) {
            document.querySelectorAll('.match-menu').forEach(m => m.classList.remove('open'));
        }
    });

    const video = document.getElementById("videoPerfil");
    const sinVideo = document.getElementById("sinVideo");
    const nombre = document.getElementById("nombrePerfil");
    const biografia = document.getElementById("biografiaPerfil");
    const instrumento = document.getElementById("instrumentoPerfil");
    const etiquetas = document.getElementById("etiquetasPerfil");

    const btnLike = document.getElementById("btnLike");
    const btnComentario = document.getElementById("btnComentario");
    const btnDislike = document.getElementById("btnDislike");
    const btnAnterior = document.getElementById("videoAnterior");
    const btnSiguiente = document.getElementById("videoSiguiente");

    const contadorVideos = document.getElementById("contadorVideos");
    const mensajeFinal = document.getElementById("mensajeFinal");
    const perfilSeccion = document.querySelector(".perfil-seccion");
    const buscador = document.getElementById("buscarPerfil");

    let indiceUsuario = 0;
    let indiceVideo = 0;
    let listaFiltrada = [...usuarios];

    function mostrarVideo() {
        const usuario = listaFiltrada[indiceUsuario];
        const videos = usuario?.videos || [];

        if (videos.length === 0) {
            video.pause();
            video.removeAttribute("src");
            video.load();

            video.hidden = true;
            sinVideo.hidden = false;
            contadorVideos.textContent = "0 videos";

            btnAnterior.hidden = true;
            btnSiguiente.hidden = true;

            return;
        }

        indiceVideo = (indiceVideo + videos.length) % videos.length;

        video.src = videos[indiceVideo];
        video.hidden = false;
        sinVideo.hidden = true;

        contadorVideos.textContent = `${indiceVideo + 1} / ${videos.length}`;

        btnAnterior.hidden = videos.length <= 1;
        btnSiguiente.hidden = videos.length <= 1;

        video.load();
        video.play().catch(() => {});
    }

    function mostrarUsuario() {
        if (indiceUsuario >= listaFiltrada.length) {
            video.pause();
            video.removeAttribute("src");
            video.load();

            perfilSeccion.hidden = true;
            mensajeFinal.hidden = false;

            return;
        }

        const usuario = listaFiltrada[indiceUsuario];

        nombre.textContent = `${usuario.apodo || "Usuario"} (${usuario.edad ?? "Edad no indicada"})`;
        biografia.textContent = usuario.biografia || "Sin descripción";
        instrumento.textContent = "Instrumento: " + (usuario.instrumentoPrincipal || "No especificado");

        etiquetas.replaceChildren();

        (usuario.etiquetas || []).forEach(texto => {
            const etiqueta = document.createElement("span");
            etiqueta.className = "etiqueta";
            etiqueta.textContent = texto;
            etiquetas.appendChild(etiqueta);
        });

        indiceVideo = 0;
        mostrarVideo();
    }

    function siguienteUsuario() {
        indiceUsuario++;
        mostrarUsuario();
    }

    btnAnterior.addEventListener("click", () => {
        indiceVideo--;
        mostrarVideo();
    });

    btnSiguiente.addEventListener("click", () => {
        indiceVideo++;
        mostrarVideo();
    });

    btnLike.addEventListener("click", siguienteUsuario);
    btnDislike.addEventListener("click", siguienteUsuario);
    btnComentario.addEventListener("click", () => {
        alert("Funcionalidad de comentarios pendiente");
    });

    buscador.addEventListener("input", () => {
        const busqueda = buscador.value.trim().toLowerCase();

        listaFiltrada = usuarios.filter(usuario =>
            (usuario.apodo || "").toLowerCase().includes(busqueda)
        );

        indiceUsuario = 0;

        perfilSeccion.hidden = false;
        mensajeFinal.hidden = true;

        mostrarUsuario();
    });

    mostrarUsuario();
</script>