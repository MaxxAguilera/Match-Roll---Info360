@using System.Diagnostics.Eventing.Reader
@using MatchRollInfo360.Models
@{
    var bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MatchandRoll</title>
    <link rel="stylesheet" href="~/css/headeryfooter.css"/>
    <link rel="stylesheet" href="~/css/header.css"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&family=Outfit:wght@400;500;600&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/css/site.css"/>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@bodyClass">
    @await Html.PartialAsync("_Header")

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <ul class="site-footer__links site-footer__links--left">
            <li><a href="#">Sobre nosotros</a></li>
            <li><a href="#">Contacto</a></li>
            <li><a href="#">Accesibilidad</a></li>
        </ul>

        <div class="site-footer__center">
            <img src="~/img/LOGO.png" alt="Match&Roll" class="site-footer__logo" />
            <div class="site-footer__social">
                <a href="#" aria-label="X"><img src="~/img/x.png" alt="" /></a>
                <a href="#" aria-label="Facebook"><img src="~/img/facebook.png" alt="" /></a>
                <a href="#" aria-label="Instagram"><img src="~/img/instagram.png" alt="" /></a>
            </div>
            <small>Copyright © @DateTime.Now.Year Match&amp;Roll</small>
        </div>

        <ul class="site-footer__links site-footer__links--right">
            <li><a href="#">Que hacemos</a></li>
            <li><a href="#">Aviso legal y privacidad</a></li>
            <li><a href="#">Cookies</a></li>
        </ul>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (Context.Session.GetString("id") != null)
    {
        <script>
            (() => {
                const badge = document.getElementById("mensajesNoLeidosBadge");

                async function actualizarMensajesNoLeidos() {
                    try {
                        const response = await fetch('@Url.Action("ObtenerMensajesNoLeidos", "Home")');
                        if (!response.ok) return;

                        const data = await response.json();
                        const cantidad = Number(data.cantidad || 0);

                        if (badge) {
                            badge.textContent = cantidad > 99 ? "99+" : cantidad.toString();
                            badge.hidden = cantidad === 0;
                        }
                    } catch (error) {
                        console.error("No se pudo actualizar mensajes no leídos:", error);
                    }
                }

                actualizarMensajesNoLeidos();
                setInterval(actualizarMensajesNoLeidos, 10000);
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
