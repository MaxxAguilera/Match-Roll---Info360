@using System.Diagnostics.Eventing.Reader
@using MatchRollInfo360.Models
@{
    var bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MatchandRoll</title>
    <link rel="stylesheet" href="~/css/headeryfooter.css"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&family=Outfit:wght@400;500;600&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/css/site.css"/>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@bodyClass">
    <header>
        <a href="@Url.Action("Index", "Home")" class="navbar__logo">
            <img src="~/img/logo.png" alt="Match&Roll" />
        </a>

        @if (!(ViewData["HideNav"] as bool? ?? false))
        {
            <nav class="navbar__nav">
                <a href="@Url.Action("VistaMatch", "Home")">Match</a>
                <a href="@Url.Action("VistaSalas", "Home")">Salas</a>
                <a href="@Url.Action("VistaChat", "Home")">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 7.5A2.5 2.5 0 0 1 7.5 5h9A2.5 2.5 0 0 1 19 7.5v6A2.5 2.5 0 0 1 16.5 16H11l-5 3v-3.5A2.5 2.5 0 0 1 5 13.5v-6Z"/>
                        <path d="M8.5 9.5h7M8.5 12.5h5"/>
                    </svg>
                    <span class="navbar__msg-badge" id="mensajesNoLeidosBadge" hidden>0</span>
                </a>
                <a href="@Url.Action("VistaPerfil", "Home")" class="navbar__avatar" aria-label="Mi perfil">
                    @if (!string.IsNullOrEmpty(ViewBag.fotoPerfilUrl))
                    {
                        <img src="@ViewBag.fotoPerfilUrl" alt="Foto de perfil" />
                    }
                    else
                    {
                        <svg viewBox="0 0 52 52" aria-hidden="true">
                            <circle cx="26" cy="19" r="8" />
                            <path d="M9 52c0-11 7.5-17 17-17s17 6 17 17z" />
                        </svg>
                    }
                </a>
            </nav>
        }
        else
        {
            <nav class="navbar__nav">
                <a href="@Url.Action("VistaIniciarSesionBeta", "Home")" class="navbar__btn navbar__btn--auth">Iniciar sesión</a>
                <a href="@Url.Action("Registrarse", "Home")" class="navbar__btn navbar__btn--auth">Crear cuenta</a>
            </nav>
        }
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <ul>
            <li><a href="">Sobre nosotros</a></li>
            <li><a href="">Contacto</a></li>
            <li><a href="">Accesibilidad</a></li>
        </ul>

        <div>
            <img src="~/img/LOGO.png" alt="Match&Roll" class="site-footer__logo" />
            <div class="redesSociales">
                <a href="#" aria-label="X"><img src="~/img/x.png" alt="" /></a>
                <a href="#" aria-label="Facebook"><img src="~/img/facebook.png" alt="" /></a>
                <a href="#" aria-label="Instagram"><img src="~/img/instagram.png" alt="" /></a>
            </div>
            <small>Copyright &copy; @DateTime.Now.Year Match&amp;Roll</small>
        </div>

        <ul>
            <li><a href="">Que hacemos</a></li>
            <li><a href="">Aviso legal y privacidad</a></li>
            <li><a href="">Cookies</a></li>
        </ul>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (Context.Session.GetString("id") != null)
    {
        <script>
            (() => {
                const badge = document.getElementById("mensajesNoLeidosBadge");

                async function actualizarMensajesNoLeidos() {
                    try {
                        const response = await fetch('@Url.Action("ObtenerMensajesNoLeidos", "Home")');
                        if (!response.ok) return;

                        const data = await response.json();
                        const cantidad = Number(data.cantidad || 0);

                        if (badge) {
                            badge.textContent = cantidad > 99 ? "99+" : cantidad.toString();
                            badge.hidden = cantidad === 0;
                        }
                    } catch (error) {
                        console.error("No se pudo actualizar mensajes no leídos:", error);
                    }
                }

                actualizarMensajesNoLeidos();
                setInterval(actualizarMensajesNoLeidos, 10000);
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
